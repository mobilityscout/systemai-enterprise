<?php
/**
 * SystemAI - Main Entry Point
 * Routes all requests correctly
 */

$path = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);

// API Request - route to api.php
if (strpos($path, '/index.php') !== false || $path === '/') {
    if (!empty($_GET['api'])) {
        // API call
        include __DIR__ . '/api.php';
        exit;
    }
}

// Default: show UI
include __DIR__ . '/ui.php';
?>
