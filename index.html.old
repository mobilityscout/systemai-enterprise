<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SystemAI Dashboard Manager</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, #0f0f23 0%, #1a1a3e 100%);
      color: #e0e0e0;
      min-height: 100vh;
      padding: 20px;
    }

    .container { max-width: 1400px; margin: 0 auto; }

    .header {
      text-align: center;
      margin-bottom: 40px;
    }

    .header h1 {
      color: #00ff88;
      font-size: 42px;
      margin-bottom: 10px;
    }

    .status-badge {
      display: inline-block;
      background: #00ff88;
      color: #0f0f23;
      padding: 8px 16px;
      border-radius: 999px;
      font-weight: bold;
      font-size: 12px;
    }

    .main-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 20px;
      margin-bottom: 30px;
    }

    .card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(0, 255, 136, 0.3);
      border-radius: 16px;
      padding: 25px;
      backdrop-filter: blur(10px);
    }

    .card h2 {
      color: #00ff88;
      font-size: 18px;
      margin-bottom: 20px;
    }

    .upload-zone {
      border: 2px dashed rgba(0, 255, 136, 0.5);
      border-radius: 12px;
      padding: 30px;
      text-align: center;
      cursor: pointer;
      transition: all 0.3s;
      margin-bottom: 15px;
    }

    .upload-zone:hover {
      border-color: #00ff88;
      background: rgba(0, 255, 136, 0.05);
    }

    .upload-zone.dragover {
      border-color: #00ff88;
      background: rgba(0, 255, 136, 0.1);
    }

    #fileInput { display: none; }

    .button-group {
      display: flex;
      gap: 10px;
      margin-bottom: 15px;
    }

    .btn {
      flex: 1;
      padding: 10px 15px;
      border: none;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
    }

    .btn-primary {
      background: linear-gradient(135deg, #00ff88 0%, #00cc6f 100%);
      color: #0f0f23;
    }

    .btn-primary:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(0, 255, 136, 0.3);
    }

    .btn-secondary {
      background: rgba(0, 255, 136, 0.15);
      color: #00ff88;
      border: 1px solid rgba(0, 255, 136, 0.3);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .status-message {
      padding: 12px;
      border-radius: 8px;
      font-size: 12px;
      margin-bottom: 15px;
      display: none;
    }

    .status-message.show { display: block; }
    .status-message.success {
      background: rgba(34, 197, 94, 0.2);
      color: #86efac;
      border: 1px solid rgba(34, 197, 94, 0.4);
    }

    .status-message.error {
      background: rgba(239, 68, 68, 0.2);
      color: #fca5a5;
      border: 1px solid rgba(239, 68, 68, 0.4);
    }

    .status-message.info {
      background: rgba(59, 130, 246, 0.2);
      color: #93c5fd;
      border: 1px solid rgba(59, 130, 246, 0.4);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-bottom: 15px;
    }

    .stat-box {
      background: rgba(0, 255, 136, 0.1);
      border: 1px solid rgba(0, 255, 136, 0.2);
      border-radius: 8px;
      padding: 12px;
      text-align: center;
    }

    .stat-value {
      font-size: 20px;
      color: #00ff88;
      font-weight: bold;
    }

    .stat-label {
      font-size: 10px;
      color: #aaa;
      margin-top: 3px;
    }

    .indexer-output {
      background: #0a0a15;
      border: 1px solid rgba(0, 255, 136, 0.2);
      border-radius: 8px;
      padding: 15px;
      max-height: 300px;
      overflow-y: auto;
      font-family: 'Courier New', monospace;
      font-size: 11px;
      line-height: 1.5;
    }

    .log-entry {
      margin-bottom: 6px;
      padding: 6px;
      border-left: 2px solid transparent;
    }

    .log-entry.element {
      border-left-color: #00ff88;
      color: #86efac;
    }

    .log-entry.attribute {
      border-left-color: #3b82f6;
      color: #93c5fd;
      margin-left: 15px;
    }

    .log-entry.error {
      border-left-color: #ef4444;
      color: #fca5a5;
    }

    .log-entry.info {
      border-left-color: #06b6d4;
      color: #a5f3fc;
    }

    .backups-list {
      list-style: none;
      max-height: 250px;
      overflow-y: auto;
    }

    .backup-item {
      background: rgba(0, 255, 136, 0.1);
      border: 1px solid rgba(0, 255, 136, 0.2);
      border-radius: 6px;
      padding: 10px;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .backup-info {
      flex: 1;
    }

    .backup-name {
      font-size: 11px;
      color: #00ff88;
      font-weight: 600;
      word-break: break-all;
    }

    .backup-meta {
      font-size: 10px;
      color: #aaa;
      margin-top: 2px;
    }

    .backup-actions {
      display: flex;
      gap: 5px;
    }

    .btn-small {
      padding: 4px 8px;
      font-size: 10px;
      background: rgba(0, 255, 136, 0.2);
      color: #00ff88;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }

    .btn-small:hover {
      background: rgba(0, 255, 136, 0.3);
    }

    .preview-frame {
      width: 100%;
      height: 500px;
      border: 1px solid rgba(0, 255, 136, 0.3);
      border-radius: 12px;
      background: white;
      display: none;
    }

    .preview-frame.show { display: block; }

    .empty-state {
      text-align: center;
      padding: 40px 20px;
      color: #aaa;
    }

    @media (max-width: 1200px) {
      .main-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 768px) {
      .main-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🚀 SystemAI Dashboard Manager</h1>
      <p>Professional UI/UX Management mit Pixel-Perfect HTML Indexing</p>
      <span class="status-badge">✅ Production Ready</span>
    </div>

    <div class="main-grid">
      
      <!-- UPLOAD CARD -->
      <div class="card">
        <h2>📤 Dashboard Upload</h2>
        
        <div class="upload-zone" id="uploadZone">
          <div style="font-size: 32px; margin-bottom: 10px;">📁</div>
          <div style="font-size: 13px;">
            <strong style="color: #00ff88;">HTML ablegen</strong><br>
            <span style="color: #aaa; font-size: 11px;">oder klicken</span>
          </div>
        </div>

        <input type="file" id="fileInput" accept=".html" />

        <div class="button-group">
          <button class="btn btn-primary" id="selectBtn">📁 Wählen</button>
          <button class="btn btn-secondary" id="uploadBtn" disabled>⚡ Upload</button>
        </div>

        <div id="uploadStatus" class="status-message"></div>

        <div class="stats-grid">
          <div class="stat-box">
            <div class="stat-value" id="fileSize">0 KB</div>
            <div class="stat-label">Größe</div>
          </div>
          <div class="stat-box">
            <div class="stat-value" id="elementCount">0</div>
            <div class="stat-label">Elemente</div>
          </div>
        </div>
      </div>

      <!-- INDEXER OUTPUT -->
      <div class="card">
        <h2>🔍 HTML Indexer</h2>
        <div class="indexer-output" id="indexerOutput">
          <div class="log-entry info">⏳ Warte auf Upload...</div>
        </div>
      </div>

      <!-- BACKUPS -->
      <div class="card">
        <h2>💾 Backups</h2>
        <ul class="backups-list" id="backupsList">
          <li class="log-entry info">Lade Backups...</li>
        </ul>
        <button class="btn btn-secondary" id="refreshBackups" style="width: 100%; margin-top: 10px;">🔄 Refresh</button>
      </div>
    </div>

    <!-- PREVIEW -->
    <div class="card">
      <h2>👁️ Live Preview</h2>
      <iframe id="previewFrame" class="preview-frame"></iframe>
      <div class="empty-state" id="emptyState">
        <div style="font-size: 48px; margin-bottom: 10px; opacity: 0.5;">🎨</div>
        <p>Preview nach Upload</p>
      </div>
    </div>
  </div>

  <script>
    const uploadZone = document.getElementById('uploadZone');
    const fileInput = document.getElementById('fileInput');
    const selectBtn = document.getElementById('selectBtn');
    const uploadBtn = document.getElementById('uploadBtn');
    const indexerOutput = document.getElementById('indexerOutput');
    const uploadStatus = document.getElementById('uploadStatus');
    const previewFrame = document.getElementById('previewFrame');
    const emptyState = document.getElementById('emptyState');
    const backupsList = document.getElementById('backupsList');
    const refreshBackups = document.getElementById('refreshBackups');

    let selectedFile = null;

    // FILE SELECTION
    selectBtn.addEventListener('click', () => fileInput.click());
    
    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) handleFileSelect(file);
    });

    // DRAG & DROP
    uploadZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadZone.classList.add('dragover');
    });

    uploadZone.addEventListener('dragleave', () => {
      uploadZone.classList.remove('dragover');
    });

    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadZone.classList.remove('dragover');
      const file = e.dataTransfer.files[0];
      if (file && file.name.endsWith('.html')) {
        handleFileSelect(file);
      } else {
        showStatus('❌ Nur HTML-Dateien!', 'error');
      }
    });

    function handleFileSelect(file) {
      selectedFile = file;
      const sizeKB = (file.size / 1024).toFixed(2);
      document.getElementById('fileSize').textContent = sizeKB + ' KB';
      uploadBtn.disabled = false;
      showStatus(`✅ ${file.name} (${sizeKB} KB)`, 'info');
    }

    // UPLOAD & INDEX
    uploadBtn.addEventListener('click', async () => {
      if (!selectedFile) return;

      uploadBtn.disabled = true;
      showStatus('⏳ Indexierung läuft...', 'info');
      clearIndexer();

      try {
        const html = await selectedFile.text();
        
        // Indexiere
        indexPixelPerfect(html);

        // Upload zu Server
        const response = await fetch('/api/save-dashboard', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ html: html })
        });

        const result = await response.json();
        
        if (result.success) {
          showStatus(`✅ ${result.message}`, 'success');
          logEntry(`💾 Backup: ${result.backup}`, 'info');
          
          // Preview
          emptyState.style.display = 'none';
          previewFrame.classList.add('show');
          previewFrame.srcdoc = html;
          
          // Refresh backups
          loadBackups();
        } else {
          showStatus('❌ ' + result.message, 'error');
        }
      } catch (error) {
        showStatus('❌ ' + error.message, 'error');
        logEntry(`ERROR: ${error.message}`, 'error');
      }

      uploadBtn.disabled = false;
    });

    // INDEXER
    function indexPixelPerfect(htmlString) {
      const parser = new DOMParser();
      const doc = parser.parseFromString(htmlString, 'text/html');

      logEntry('═════════════════════════════════════', 'info');
      logEntry('📋 PIXEL-PERFECT HTML INDEXING', 'element');
      logEntry('═════════════════════════════════════', 'info');

      // Metadaten
      logEntry(`Title: ${doc.title}`, 'attribute');
      logEntry(`Size: ${(htmlString.length / 1024).toFixed(2)} KB`, 'attribute');

      // Elements
      const allElements = doc.body.querySelectorAll('*');
      logEntry(`Total Elements: ${allElements.length}`, 'attribute');

      const elementMap = {};
      allElements.forEach(el => {
        const tag = el.tagName.toLowerCase();
        elementMap[tag] = (elementMap[tag] || 0) + 1;
      });

      logEntry('📊 Element Distribution:', 'element');
      Object.entries(elementMap)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 10)
        .forEach(([tag, count]) => {
          logEntry(`<${tag}>: ${count}`, 'attribute');
        });

      // CSS
      const styles = doc.querySelectorAll('style');
      logEntry('', 'info');
      logEntry(`🎨 CSS Blocks: ${styles.length}`, 'element');
      
      const classSet = new Set();
      const idSet = new Set();
      allElements.forEach(el => {
        if (el.id) idSet.add(el.id);
        if (el.className) {
          el.className.toString().split(' ').forEach(c => {
            if (c) classSet.add(c);
          });
        }
      });
      logEntry(`Classes: ${classSet.size}`, 'attribute');
      logEntry(`IDs: ${idSet.size}`, 'attribute');

      logEntry('════════════════════════════════════���', 'info');
      document.getElementById('elementCount').textContent = allElements.length;
    }

    function logEntry(text, type = 'info') {
      const entry = document.createElement('div');
      entry.className = `log-entry ${type}`;
      entry.textContent = text;
      indexerOutput.appendChild(entry);
      indexerOutput.scrollTop = indexerOutput.scrollHeight;
    }

    function clearIndexer() {
      indexerOutput.innerHTML = '';
    }

    function showStatus(message, type) {
      uploadStatus.textContent = message;
      uploadStatus.className = `status-message show ${type}`;
    }

    // BACKUPS
    async function loadBackups() {
      try {
        const response = await fetch('/api/backups');
        const result = await response.json();
        
        if (result.success) {
          backupsList.innerHTML = '';
          
          if (result.backups.length === 0) {
            backupsList.innerHTML = '<li class="log-entry info">Keine Backups vorhanden</li>';
            return;
          }

          result.backups.forEach(backup => {
            const li = document.createElement('li');
            li.className = 'backup-item';
            li.innerHTML = `
              <div class="backup-info">
                <div class="backup-name">${backup.filename}</div>
                <div class="backup-meta">${backup.date} (${(backup.size / 1024).toFixed(2)} KB)</div>
              </div>
              <div class="backup-actions">
                <button class="btn-small" onclick="restoreBackup('${backup.filename}')">Restore</button>
              </div>
            `;
            backupsList.appendChild(li);
          });
        }
      } catch (error) {
        backupsList.innerHTML = `<li class="log-entry error">Fehler: ${error.message}</li>`;
      }
    }

    async function restoreBackup(filename) {
      if (!confirm(`Wiederherstellen: ${filename}?`)) return;

      try {
        const response = await fetch('/api/restore-backup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ backup: filename })
        });

        const result = await response.json();
        
        if (result.success) {
          showStatus(`✅ ${result.message}`, 'success');
          location.reload();
        } else {
          showStatus('❌ ' + result.message, 'error');
        }
      } catch (error) {
        showStatus('❌ ' + error.message, 'error');
      }
    }

    refreshBackups.addEventListener('click', loadBackups);

    // Init
    loadBackups();
    window.restoreBackup = restoreBackup;
  </script>
</body>
</html>
