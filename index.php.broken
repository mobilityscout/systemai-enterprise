<?php
if (strpos($_SERVER['REQUEST_URI'], '?api=') === false) {
    header('Content-Type: text/html; charset=utf-8');
} else {
    header('Content-Type: application/json; charset=utf-8');
}
header('Access-Control-Allow-Origin: *');

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') { http_response_code(200); exit; }

class SystemAI {
    private $pdo = null;
    
    public function __construct() {
        try {
            $this->pdo = new PDO("pgsql:host=localhost;dbname=systemai", "systemai", "systemai");
        } catch (Exception $e) {}
    }
    
    public function route($request) {
        if (empty($request)) return $this->serveUI();
        if ($request === 'dashboard') return $this->getDashboard();
        if ($request === 'services') return $this->getServices();
        if ($request === 'database') return $this->getDatabase();
        if ($request === 'modules') return $this->getModules();
        if ($request === 'workers') return $this->getWorkers();
        if ($request === 'health') return $this->getHealth();
        return ['error' => 'Unknown API'];
    }
    
    private function getDashboard() {
        return [
            'system' => ['version' => '1.0.0', 'uptime' => trim(shell_exec('uptime -p')), 'hostname' => gethostname()],
            'services' => ['nginx' => trim(shell_exec('systemctl is-active nginx 2>&1')), 'postgresql' => trim(shell_exec('systemctl is-active postgresql 2>&1')), 'php' => 'active'],
            'health_score' => 100,
            'timestamp' => date('Y-m-d H:i:s')
        ];
    }
    
    private function getServices() {
        return ['services' => ['nginx' => ['status' => trim(shell_exec('systemctl is-active nginx 2>&1'))], 'postgresql' => ['status' => trim(shell_exec('systemctl is-active postgresql 2>&1'))], 'php8.3-fpm' => ['status' => 'active']]];
    }
    
    private function getDatabase() {
        if (!$this->pdo) return ['error' => 'Database not available'];
        try {
            $stmt = $this->pdo->query("SELECT pg_size_pretty(pg_database_size('systemai')) as size");
            $db_size = $stmt->fetch(PDO::FETCH_ASSOC);
            $stmt = $this->pdo->query("SELECT tablename, n_live_tup as rows, pg_size_pretty(pg_total_relation_size('\"public\".\"' || tablename || '\"')) as size FROM pg_stat_user_tables ORDER BY pg_total_relation_size('\"public\".\"' || tablename || '\"') DESC LIMIT 20");
            $tables = $stmt->fetchAll(PDO::FETCH_ASSOC);
            return ['size' => $db_size['size'], 'tables' => count($tables), 'top_tables' => $tables];
        } catch (Exception $e) {
            return ['error' => $e->getMessage()];
        }
    }
    
    private function getModules() {
        $modules = [];
        $files = glob('/var/www/systemai/*.php');
        foreach ($files as $file) {
            $modules[] = ['name' => basename($file), 'size' => filesize($file)];
        }
        return ['total' => count($modules), 'modules' => $modules];
    }
    
    private function getWorkers() {
        return ['workers' => [['name' => 'ProjectAI', 'status' => 'STOPPED', 'port' => 9010]]];
    }
    
    private function getHealth() {
        $nginx = trim(shell_exec('systemctl is-active nginx 2>&1')) === 'active' ? 25 : 0;
        $postgres = trim(shell_exec('systemctl is-active postgresql 2>&1')) === 'active' ? 25 : 0;
        $score = $nginx + $postgres + 50;
        return ['score' => $score, 'status' => 'HEALTHY', 'components' => ['nginx' => $nginx, 'postgresql' => $postgres]];
    }
    
    private function serveUI() {
        ?><!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SystemAI Enterprise Control Plane</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: "Courier New", monospace; background: #0a0e27; color: #e0e0e0; display: flex; height: 100vh; }
        .sidebar { width: 280px; background: #0f1835; border-right: 1px solid rgba(0,255,136,0.2); padding: 20px; overflow-y: auto; }
        .logo { color: #00ff88; font-size: 16px; font-weight: bold; margin-bottom: 25px; }
        .section-title { color: #00ff88; font-size: 10px; text-transform: uppercase; margin-top: 20px; margin-bottom: 10px; opacity: 0.6; }
        .menu { display: flex; flex-direction: column; gap: 5px; }
        .menu-item { padding: 10px; border-radius: 6px; cursor: pointer; color: #888; transition: 0.3s; border-left: 3px solid transparent; font-size: 12px; }
        .menu-item:hover { background: rgba(0,255,136,0.1); color: #00ff88; }
        .menu-item.active { background: rgba(0,255,136,0.1); color: #00ff88; border-left-color: #00ff88; font-weight: bold; }
        .main { flex: 1; overflow-y: auto; padding: 30px; }
        .header h1 { color: #00ff88; font-size: 26px; margin-bottom: 20px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px; margin: 20px 0; }
        .card { background: rgba(255,255,255,0.03); border: 1px solid rgba(0,255,136,0.2); border-radius: 8px; padding: 15px; }
        .card h2 { color: #00ff88; font-size: 12px; margin-bottom: 12px; text-transform: uppercase; }
        .stat { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(0,255,136,0.1); font-size: 11px; }
        .stat-value { color: #00ff88; font-weight: bold; }
        .btn { padding: 8px 12px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; background: #00ff88; color: #0a0e27; font-size: 11px; margin-right: 8px; }
        .btn:hover { background: #00dd77; }
        .spinner { border: 2px solid rgba(0,255,136,0.2); border-top: 2px solid #00ff88; border-radius: 50%; width: 25px; height: 25px; animation: spin 1s linear infinite; margin: 20px auto; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        table { width: 100%; border-collapse: collapse; font-size: 10px; margin-top: 10px; }
        th, td { padding: 8px; text-align: left; border-bottom: 1px solid rgba(0,255,136,0.1); }
        th { background: rgba(0,255,136,0.1); color: #00ff88; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo">⚙️ SystemAI</div>
        <div class="section-title">Control Plane</div>
        <div class="menu">
            <div class="menu-item active" data-section="dashboard">📊 Dashboard</div>
            <div class="menu-item" data-section="services">🖥️ Services</div>
        </div>
        <div class="section-title">Management</div>
        <div class="menu">
            <div class="menu-item" data-section="database">🗄️ Database</div>
            <div class="menu-item" data-section="modules">📦 Modules</div>
            <div class="menu-item" data-section="workers">🤖 Workers</div>
        </div>
        <div class="section-title">Operations</div>
        <div class="menu">
            <div class="menu-item" data-section="health">🏥 Health</div>
        </div>
    </div>
    
    <div class="main">
        <div class="header">
            <h1 id="title">📊 Dashboard</h1>
        </div>
        <button class="btn" onclick="load('dashboard')">🔄 Refresh</button>
        <div id="content"><div class="spinner"></div></div>
    </div>
    
    <script>
        document.querySelectorAll('.menu-item').forEach(item => {
            item.addEventListener('click', function() {
                const section = this.getAttribute('data-section');
                document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('title').textContent = this.textContent;
                load(section);
            });
        });
        
        async function load(api) {
            const r = await fetch('/index.php?api=' + api);
            const d = await r.json();
            let html = '';
            
            if (api === 'dashboard') {
                html = '<div class="grid"><div class="card"><h2>System</h2><div class="stat"><span>Version</span><span class="stat-value">1.0.0</span></div><div class="stat"><span>Uptime</span><span class="stat-value">' + d.system.uptime + '</span></div></div><div class="card"><h2>Services</h2><div class="stat"><span>Nginx</span><span class="stat-value">' + d.services.nginx + '</span></div><div class="stat"><span>PostgreSQL</span><span class="stat-value">' + d.services.postgresql + '</span></div></div><div class="card"><h2>Health</h2><div class="stat"><span>Score</span><span class="stat-value">100/100</span></div></div></div>';
            } else if (api === 'services') {
                html = '<div class="card"><h2>Services</h2>';
                for (let s in d.services) {
                    html += '<div class="stat"><span>' + s + '</span><span class="stat-value">' + d.services[s].status + '</span></div>';
                }
                html += '</div>';
            } else if (api === 'database') {
                html = '<div class="card"><h2>Database</h2>';
                if (d.size) {
                    html += '<div class="stat"><span>Size</span><span class="stat-value">' + d.size + '</span></div>';
                    html += '<div class="stat"><span>Tables</span><span class="stat-value">' + d.tables + '</span></div>';
                    html += '<h3 style="color:#00ff88; margin-top:15px;">Top Tables</h3><table><tr><th>Table</th><th>Rows</th><th>Size</th></tr>';
                    d.top_tables.forEach(t => {
                        html += '<tr><td>' + t.tablename + '</td><td>' + t.rows + '</td><td>' + t.size + '</td></tr>';
                    });
                    html += '</table>';
                }
                html += '</div>';
            } else if (api === 'modules') {
                html = '<div class="card"><h2>Modules (' + d.total + ')</h2><table><tr><th>Name</th><th>Size</th></tr>';
                d.modules.forEach(m => {
                    html += '<tr><td>' + m.name + '</td><td>' + (m.size / 1024).toFixed(1) + ' KB</td></tr>';
                });
                html += '</table></div>';
            } else if (api === 'workers') {
                html = '<div class="card"><h2>Workers</h2>';
                d.workers.forEach(w => {
                    html += '<div style="padding:10px; background:rgba(0,255,136,0.05); margin:8px 0; border-radius:4px;"><strong>' + w.name + '</strong> - ' + w.status + '<br><span style="color:#666; font-size:10px;">Port: ' + w.port + '</span></div>';
                });
                html += '</div>';
            } else if (api === 'health') {
                html = '<div class="card"><h2>Health: ' + d.status + '</h2><div style="font-size:28px; color:#00ff88; font-weight:bold; text-align:center; margin:20px 0;">' + d.score + '/100</div></div>';
            }
            
            document.getElementById('content').innerHTML = html;
        }
        
        load('dashboard');
    </script>
</body>
</html><?php
        exit;
    }
}

$api = $_GET['api'] ?? '';
$system = new SystemAI();

if (empty($api)) {
    $system->route('ui');
} else {
    echo json_encode($system->route($api));
}
?>
